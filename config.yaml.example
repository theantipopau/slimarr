# Slimarr configuration - edit these settings via the web UI at http://localhost:9494
server:
  port: 9494

auth:
  secret_key: ""
  api_key: ""

plex:
  url: ""
  token: ""

download_client: "sabnzbd"

sabnzbd:
  url: ""
  api_key: ""
  category: "slimarr"

nzbget:
  url: ""
  username: ""
  password: ""
  category: "slimarr"

tmdb:
  api_key: ""

automation:
  dry_run: false
  review_required: false

comparison:
  min_savings_percent: 10.0
  min_savings_mb_for_nas: 0
  allow_resolution_downgrade: false
  downgrade_min_savings_percent: 40.0
  preferred_codecs:
    - av1
    - h265
  preferred_audio_codecs: []
  require_preferred_audio_match: false
  preferred_language: english
  max_candidate_age_days: 3650
  minimum_file_size_mb: 500
  reject_upscaled: true
  minimum_confidence_score: 55.0
  require_year_match: true

schedule:
  mode: nightly
  timezone: local
  start_time: "23:00"
  end_time: "05:00"
  days: [mon, tue, wed, thu, fri, sat, sun]
  min_cycle_interval_minutes: 60
  max_downloads_per_night: 10
  throttle_seconds: 30
  max_active_download_hours: 24

exclusions:
  movie_ids: []
  title_keywords: []
  folders: []
  codecs: []
  resolutions: []
  minimum_file_size_mb: 0
  maximum_age_days: 0

radarr:
  enabled: false
  url: ""
  api_key: ""
  # Action to take in Radarr after Slimarr replaces a file:
  #   rescan           - notify Radarr to rescan (default)
  #   rescan_unmonitor - rescan + unmonitor the movie (prevents Radarr re-downloading)
  #   none             - do nothing
  post_replace_action: "rescan"

sonarr:
  enabled: false
  url: ""
  api_key: ""

prowlarr:
  enabled: false
  url: ""
  api_key: ""

files:
  recycling_bin: ""
  recycling_bin_cleanup_days: 30
  verify_after_download: true
  enable_media_probe: false
  # nas_probe_enabled: false   # Keep false. Probing NAS files reads bytes over the
  #                            # network and can stall SMB/NFS storage.
  # media_probe_timeout_seconds: 30
  #
  # List the root paths of any network-attached storage below.
  # Slimarr uses this to apply NAS write budgets and to skip probing those files.
  # Accepted formats (any combination):
  #   Windows mapped drive : "Z:\"   or  "Z:"
  #   Windows UNC path     : "\\\\SERVER\\share"   (UNC paths are also auto-detected
  #                                                  even without listing them here)
  #   Linux/Mac mount      : "/mnt/nas"
  #   Docker volume        : "/data/media"
  #
  # Examples:
  #   nas_path_prefixes:
  #     - "Z:\\"
  #     - "/mnt/nas"
  #     - "\\\\\\\\NASBOX\\\\media"
  nas_path_prefixes: []
  nas_max_write_gb_per_day: 150.0
  nas_max_replacements_per_day: 3
  nas_max_concurrent_operations: 1
  nas_failure_cooldown_minutes: 15
  nas_max_transfer_mbps: 50.0
  nas_copy_chunk_mb: 8
  plex_path_mappings: []

indexers: []

# Recommendation & Collection Completion (optional — v2.0.0+).
# The whole feature is inert until enabled: true. It never downloads or
# replaces anything itself — it only surfaces suggestions with a Radarr/
# Sonarr/Seerr hand-off action that always requires an explicit click.
# See docs/RECOMMENDATION_ARCHITECTURE.md and docs/RECOMMENDATION_PRIVACY.md.
recommendations:
  enabled: false
  # ISO 3166-1 alpha-2 region code, e.g. "US", "AU", "GB". Leave blank to
  # disable streaming-availability lookups entirely (no region is assumed).
  region: ""
  # TMDB watch-provider IDs you actually subscribe to. Availability is still
  # computed for other providers, but these are highlighted/prioritized.
  subscribed_providers: []
  enabled_categories:
    - collection_completion
    - sequel_prequel
    - related_title
  media_types: [movie]
  minimum_score: 40.0
  languages: []
  genres_include: []
  genres_exclude: []
  excluded_keywords: []
  # Opt-in. If true, Plex watch history informs personalized scoring.
  use_plex_watch_history: false
  refresh_interval_hours: 24
  max_recommendations_retained: 500
  ai:
    # Optional and disabled by default. AI only reranks/explains an
    # already-generated candidate set — never invents titles or availability.
    enabled: false
    provider: "none"  # none | openai_compatible | anthropic | ollama
    base_url: ""
    model: ""
    api_key: ""
    timeout_seconds: 20
    # Separate from use_plex_watch_history above — must be turned on
    # independently before any watch-history signal reaches an AI provider.
    share_watch_history: false
